{
  "name": "blog",
  "projectType": "application",
  "sourceRoot": "apps/blog/src",
  "tags": [
    "scope:app",
    "type:app"
  ],
  "targets": {
    "build": {
      "options": {
        "outputPath": {
          "base": "dist/tech-blog"
        },
        "index": "apps/blog/src/index.html",
        "polyfills": [
          "apps/blog/src/polyfills.ts"
        ],
        "tsConfig": "apps/blog/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/blog/src/favicon.ico",
          "apps/blog/src/assets",
          "apps/blog/src/manifest.webmanifest"
        ],
        "styles": [
          "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
          "apps/blog/src/styles.scss"
        ],
        "scripts": [],
        "extractLicenses": false,
        "sourceMap": true,
        "optimization": false,
        "namedChunks": true,
        "serviceWorker": "ngsw-config.json",
        "browser": "apps/blog/src/main.ts",
        "server": "apps/blog/src/main.server.ts",
        "prerender": false,
        "ssr": {
          "entry": "apps/blog/server.ts"
        }
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/blog/src/environments/environment.ts",
              "with": "apps/blog/src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "serviceWorker": "ngsw-config.json"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@angular/build:application",
      "outputs": [
        "{workspaceRoot}/dist/tech-blog"
      ]
    },
    "serve": {
      "options": {
        "buildTarget": "blog:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "blog:build:production"
        },
        "development": {
          "buildTarget": "blog:build:development"
        }
      },
      "defaultConfiguration": "development",
      "executor": "@angular/build:dev-server"
    },
    "extract-i18n": {
      "options": {
        "buildTarget": "blog:build"
      },
      "executor": "@angular/build:extract-i18n"
    }
  }
}
