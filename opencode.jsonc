{
  "$schema": "https://opencode.ai/config.json",

  "references": {
    "backend": {
      "path": "../tech-blog-backend",
      "description": "Backend bloga w .NET. Używaj przy zmianach API, modeli, bazy danych i integracji z frontendem."
    }
  },

  "permission": {
    "*": "ask",

    "external_directory": {
      "*": "deny",
      "../tech-blog-backend/**": "allow"
    },

    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },

    "edit": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "opencode.jsonc": "deny"
    },

    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "git clean*": "deny",
      "git reset --hard*": "deny",
      "Remove-Item*": "deny",
      "rm *": "deny",
      "del *": "deny",
      "rmdir *": "deny"
    }
  }
}
