{
  "name": "tech-blog",
  "version": "21.0.0",
  "description": "Frontend for private blog based on Angular. ",
  "author": "Patryk Sadowski",
  "homepage": "https://patryksadowski.pl",
  "license": "MIT",
  "contributors": [
    "Patryk Sadowski"
  ],
  "keywords": [
    "angular",
    "angular 21",
    "tech-blog",
    "jest",
    "transloco",
    "prettier",
    "testcafe",
    "compodoc",
    "docker",
    "eslint",
    "storybook"
  ],
  "repository": "https://github.com/Patryk-S-W/tech-blog-frontend.git",
  "bugs": {
    "url": "https://github.com/Patryk-S-W/tech-blog-frontend/issues"
  },
  "readme": "https://github.com/Patryk-S-W/tech-blog-frontend/blob/master/README.md",
  "scripts": {
    "ng": "nx",
    "start": "nx serve tech-blog",
    "build": "nx build tech-blog",
    "build:prod": "nx build tech-blog --configuration production",
    "build:prod:stats": "nx build tech-blog --configuration production --stats-json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "nx lint tech-blog",
    "e2e": "testcafe chrome ./e2e/",
    "compodoc": "npx compodoc -p apps/tech-blog/tsconfig.app.json",
    "analyze": "source-map-explorer dist/tech-blog/**/*.js",
    "prettier": "prettier --write \"apps/tech-blog/src/app/**/*.{js,json,css,scss,less,md,ts,html,component.html}\"",
    "prepare": "husky install",
    "audit": "auditjs ossi",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "docs:json": "compodoc -p ./tsconfig.base.json -e json -d .",
    "storybook": "npm run docs:json && start-storybook -p 6006",
    "build-storybook": "npm run docs:json && build-storybook",
    "serve:ssr:tech-blog": "node dist/tech-blog/server/server.mjs"
  },
  "private": false,
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@angular/animations": "^22.0.4",
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.4",
    "@angular/compiler": "^22.0.4",
    "@angular/core": "^22.0.4",
    "@angular/forms": "^22.0.4",
    "@angular/material": "^22.0.2",
    "@angular/platform-browser": "^22.0.4",
    "@angular/platform-browser-dynamic": "^22.0.4",
    "@angular/platform-server": "^22.0.4",
    "@angular/router": "^22.0.4",
    "@angular/service-worker": "^22.0.4",
    "@angular/ssr": "^22.0.2",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@ngneat/transloco": "^6.0.4",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.2",
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/eslint-plugin-template": "^22.0.0",
    "@angular-eslint/schematics": "^22.0.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/build": "^22.0.2",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.4",
    "@angular/localize": "^22.0.4",
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@compodoc/compodoc": "^1.2.1",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "^23.0.1",
    "@nx/eslint": "^23.0.1",
    "@types/eslint": "9.6.1",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "^4.1.9",
    "angular-eslint": "^22.0.0",
    "auditjs": "^5.0.1",
    "auto-changelog": "^2.6.0",
    "babel-loader": "^10.1.1",
    "browser-sync": "^3.0.4",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.2",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jasmine-core": "~6.3.0",
    "jsdom": "^29.1.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "nx": "^23.0.1",
    "prettier": "^3.8.4",
    "prettier-eslint": "^16.4.2",
    "source-map-explorer": "^2.5.3",
    "testcafe": "^3.7.4",
    "testcafe-reporter-html": "^1.4.6",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{js,json,css,scss,less,md,ts,html,component.html}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@fortawesome/angular-fontawesome": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common"
    },
    "@ng-bootstrap/ng-bootstrap": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common",
      "@angular/forms": "$@angular/forms",
      "@angular/localize": "$@angular/localize"
    }
  }
}
