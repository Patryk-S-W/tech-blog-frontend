{
  "name": "tech-blog",
  "version": "21.0.0",
  "description": "Frontend for private blog based on Angular. ",
  "author": "Patryk Sadowski",
  "homepage": "https://patryksadowski.pl",
  "license": "MIT",
  "contributors": [
    "Patryk Sadowski"
  ],
  "keywords": [
    "angular",
    "angular 21",
    "tech-blog",
    "jest",
    "transloco",
    "prettier",
    "testcafe",
    "compodoc",
    "docker",
    "eslint",
    "storybook"
  ],
  "repository": "https://github.com/Patryk-S-W/tech-blog-frontend.git",
  "bugs": {
    "url": "https://github.com/Patryk-S-W/tech-blog-frontend/issues"
  },
  "readme": "https://github.com/Patryk-S-W/tech-blog-frontend/blob/master/README.md",
  "scripts": {
    "ng": "nx",
    "start": "nx serve blog",
    "build": "nx build blog",
    "build:prod": "nx build blog --configuration production",
    "build:prod:stats": "nx build blog --configuration production --stats-json",
    "test": "nx run-many -t test --parallel=1",
    "test:watch": "nx test blog --watch",
    "test:ci": "nx run-many -t test --parallel=1 --runInBand",
    "test:coverage": "nx run-many -t test --parallel=1 --coverage",
    "lint": "nx run-many -t lint --parallel=1",
    "e2e": "testcafe chrome ./e2e/",
    "compodoc": "compodoc -p apps/blog/tsconfig.app.json",
    "analyze": "source-map-explorer dist/tech-blog/**/*.js",
    "prettier": "prettier --write \"{apps,libs}/**/*.{js,json,css,scss,md,ts,html}\"",
    "prepare": "husky install",
    "audit": "auditjs ossi",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "docs:json": "compodoc -p apps/blog/tsconfig.app.json -e json -d .",
    "storybook": "npm run docs:json && start-storybook -p 6006",
    "build-storybook": "npm run docs:json && build-storybook",
    "serve:ssr:tech-blog": "node dist/tech-blog/server/server.mjs"
  },
  "private": false,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "dependencies": {
    "@angular/animations": "^21.2.16",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.16",
    "@angular/compiler": "^21.2.16",
    "@angular/core": "^21.2.16",
    "@angular/forms": "^21.2.16",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.16",
    "@angular/platform-browser-dynamic": "^21.2.16",
    "@angular/platform-server": "^21.2.16",
    "@angular/router": "^21.2.16",
    "@angular/service-worker": "^21.2.16",
    "@angular/ssr": "^21.2.14",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@ngneat/transloco": "^6.0.4",
    "@ngrx/signals": "^21.1.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "express": "^5.2.1",
    "marked": "^18.0.6",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.16",
    "@angular/localize": "^21.2.16",
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@compodoc/compodoc": "^1.2.1",
    "@eslint/js": "^10.0.1",
    "@types/eslint": "9.6.1",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "angular-eslint": "^21.4.0",
    "auditjs": "^5.0.1",
    "auto-changelog": "^2.6.0",
    "babel-loader": "^10.1.1",
    "browser-sync": "^3.0.4",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.2",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jasmine-core": "~6.3.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "jest-preset-angular": "^16.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "prettier": "^3.8.4",
    "prettier-eslint": "^16.4.2",
    "source-map-explorer": "^2.5.3",
    "testcafe": "^3.7.4",
    "testcafe-reporter-html": "^1.4.6",
    "ts-node": "~10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.0",
    "nx": "24.0.6",
    "@nx/angular": "24.0.6",
    "@nx/jest": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@angular-devkit/core": "21.2.14",
    "@angular-devkit/schematics": "21.2.14",
    "@schematics/angular": "21.2.14"
  },
  "lint-staged": {
    "*.{js,json,css,scss,less,md,ts,html,component.html}": [
      "prettier --write"
    ]
  },
  "nx": {
    "includedScripts": []
  }
}
